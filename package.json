{
  "name": "obsidian-inkmagix",
  "version": "1.0.1",
  "description": "Convert photos of handwriting, whiteboards and diagrams into Obsidian notes with Mermaid diagrams or draw.io files using Claude.",
  "private": true,
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "obsidian",
    "claude",
    "ocr",
    "diagram",
    "mermaid",
    "drawio"
  ],
  "author": "yaman (https://github.com/yamanor)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamanor/obsidian-inkmagix.git"
  },
  "homepage": "https://github.com/yamanor/obsidian-inkmagix#readme",
  "bugs": {
    "url": "https://github.com/yamanor/obsidian-inkmagix/issues"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.5.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest"
  }
}
